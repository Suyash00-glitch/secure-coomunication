# Copy this file to .env and fill in real values. Never commit the real .env.

# Database
DB_HOST=your-db-host
DB_PORT=3306
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=your-db-name

# JWT
JWT_SECRET=replace-with-a-long-random-secret

# Server
PORT=3000

# Credential-email SMTP configuration (Admin Create User feature)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-app-password
MAIL_FROM="Secure Communication <no-reply@example.com>"

# Portal login URLs used in the credential email
ADMIN_PORTAL_URL=http://localhost:5173/admin/login
INTERNAL_PORTAL_URL=http://localhost:5174/internal/login
EXTERNAL_PORTAL_URL=http://localhost:5175/external/login
